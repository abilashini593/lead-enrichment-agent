{"step_index":86,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-10T13:22:54Z","content":"Created At: 2026-09-10T18:52:54+05:30\nCompleted At: 2026-09-10T18:52:54+05:30\nFile Path: `file:///C:/Users/new/.gemini/antigravity/brain/4fdbd629-b1b9-4bee-a13c-8876484f2243/lead_enrichment/main.py`\nTotal Lines: 67\nTotal Bytes: 2211\nShowing lines 1 to 67\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: # lead_enrichment/main.py\n2: \"\"\"Command‑line interface for the Autonomous Lead Enrichment Agent.\n3: \n4: Usage example::\n5: \n6:     python -m lead_enrichment.main --domains postman.com supabase.com vapi.ai\n7: \n8: The script reads the list of domains, crawls each site, extracts structured\n9: information via the configured LLM, and writes a JSON file ``output.json`` in\n10: the current working directory.\n11: \"\"\"\n12: \n13: import argparse\n14: import asyncio\n15: import json\n16: import logging\n17: from pathlib import Path\n18: \n19: from .config import load_config\n20: from .crawler import process_domain\n21: from .llm import get_llm_client\n22: from .models import CompanyInfo\n23: \n24: logging.basicConfig(\n25:     level=logging.INFO,\n26:     format=\"%(asctime)s %(levelname)s %(message)s\",\n27: )\n28: \n29: async def run_domain(domain: str, llm_client) -> dict:\n30:     \"\"\"Crawl *domain*, ask the LLM to extract data, and return a dict.\n31:     Errors are captured and returned under the ``error`` key so the overall run\n32:     never aborts because one site fails.\n33:     \"\"\"\n34:     try:\n35:         content = await process_domain(domain)\n36:         if not content:\n37:             logging.warning(\"No content extracted for %s\", domain)\n38:             return {\"domain\": domain, \"error\": \"No content extracted\"}\n39:         info: CompanyInfo = await llm_client.extract_info(domain, content)\n40:         return info.dict()\n41:     except Exception as exc:  # pragma: no cover – defensive\n42:         logging.exception(\"Failed processing %s\", domain)\n43:         return {\"domain\": domain, \"error\": str(exc)}\n44: \n45: async def main_async(domains: list[str]):\n46:     cfg = load_config()\n47:     llm_client = get_llm_client(cfg)\n48:     tasks = [run_domain(d, llm_client) for d in domains]\n49:     results = await asyncio.gather(*tasks)\n50:     out_path = Path(\"output.json\")\n51:     out_path.write_text(json.dumps(results, indent=2, ensure_ascii=False))\n52:     logging.info(\"Results written to %s\", out_path)\n53: \n54: def parse_args() -> argparse.Namespace:\n55:     parser = argparse.ArgumentParser(description=\"Autonomous Lead Enrichment Agent\")\n56:     parser.add_argument(\n57:         \"--domains\",\n58:         nargs=\"+\",\n59:         required=True,\n60:         help=\"List of company domains to process\",\n61:     )\n62:     return parser.parse_args()\n63: \n64: if __name__ == \"__main__\":\n65:     args = parse_args()\n66:     asyncio.run(main_async(args.domains))\n67: \nThe above content shows the entire, complete file contents of the requested file.\n"}
{"step_index":87,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-10T13:22:55Z","thinking":"We need to debug why the crawling timed out. Possibly need to increase timeout further, maybe network restrictions; could also use a fallback to HTTP GET via requests instead of Playwright for simple pages. But better to simplify: use requests to get page HTML (no JS) and still get content. For these domains, homepage should load quickly. Let's replace crawler to use requests with timeout 30 sec, and keep Playwright for subpages that may need JS.\n\nImplement simple fetch via httpx or requests. Use httpx (already dependency via openai). Let's modify crawler: use httpx.get for base_url and subpages, with timeout. Then only use Playwright if needed? Simpler: use httpx for all pages. Replace crawler with httpx.\n\nAlso need to adjust imports.\n\nWe'll edit lead_enrichment/crawler.py to use httpx to fetch pages, with timeout and fallback. Use retry_async.\n\nLet's create new version.\n\n","tool_calls":[{"name":"replace_file_content","args":{"EndLine":200,"StartLine":1,"TargetContent":"# lead_enrichment/crawler.py\n\"\"\"Web crawling utilities.\nThis version uses plain HTTP GET requests (via httpx) for faster, more reliable\nfetching of typical static pages.  If a page fails to load within the timeout,\nthe function returns an empty string and the pipeline continues gracefully.\n\"\"\"\n\nimport logging\nfrom typing import List\nfrom urllib.parse import urljoin\n\nimport httpx\n\nfrom .processor import clean_html\nfrom .utils import retry_async\n\nlogger = logging.getLogger(__name__)\n\nCOMMON_PATHS = [\"/about\", \"/team\", \"/company\", \"/contact\", \"/pricing\"]\n\n@retry_async(attempts=3, backoff=2)\nasync def fetch_page(url: str) -> str:\n    \"\"\"Fetch *url* using httpx with a 30‑second timeout.\n    Returns the raw HTML or an empty string on failure.\n    \"\"\"\n    try:\n        async with httpx.AsyncClient(timeout=30.0) as client:\n            response = await client.get(url)\n            if response.status_code == 200:\n                return response.text\n            else:\n                logger.warning(\"Non‑200 status %s for %s\", response.status_code, url)\n                return \"\"\n    except Exception as exc:\n        logger.warning(\"Error fetching %s: %s\", url, exc)\n        return \"\"\n\nasync def discover_subpages(base_url: str) -> List[str]:\n    \"\"\"Return absolute URLs that respond with status 200 for common paths.\n    Uses httpx HEAD requests for lightweight checking.\n    \"\"\"\n    discovered = []\n    async with httpx.AsyncClient(timeout=15.0) as client:\n        for path in COMMON_PATHS:\n            candidate = urljoin(base_url, path)\n            try:\n                resp = await client.head(candidate)\n                if resp.status_code == 200:\n                    discovered.append(candidate)\n            except Exception:\n                continue\n    return discovered\n\nasync def process_domain(domain: str) -> str:\n    \"\"\"Crawl *domain* and return a single cleaned markdown string.\n    Aggregates homepage and any discovered sub‑pages.\n    \"\"\"\n    base_url = f\"https://{domain}\" if not domain.startswith(\"http\") else domain\n    contents = []\n    # Homepage\n    homepage_html = await fetch_page(base_url)\n    if homepage_html:\n        contents.append(clean_html(homepage_html))\n    # Sub‑pages\n    subpages = await discover_subpages(base_url)\n    for url in subpages:\n        html = await fetch_page(url)\n        if html:\n            contents.append(clean_html(html))\n    return \"\\n\\n---\\n\\n\".join(contents)\n","TargetFile":"C:\\Users\\new\\.gemini\\antigravity\\brain\\4fdbd629-b1b9-4bee-a13c-8876484f2243\\lead_enrichment\\crawler.py"}}]}
