            # Return placeholder with minimal info and low confidence\n            placeholder = {\n                \"domain\": domain,\n                \"overview\": \"\",\n                \"target_audience\": \"\",\n                \"contact_points\": [],\n                \"leadership\": [],\n                \"confidence_score\": 0.0,\n            }\n            return placeholder\n        info: CompanyInfo = await llm_client.extract_info(domain, content)\n        return info.dict()\n    except Exception as exc:  # pragma: no cover – defensive\n        logging.exception(\"Failed processing %s\", domain)\n        return {\"domain\": domain, \"error\": str(exc)}","TargetFile":"C:\\Users\\new\\.gemini\\antigravity\\brain\\4fdbd629-b1b9-4bee-a13c-8876484f2243\\lead_enrichment\\main.py","toolAction":"Edit main placeholder","toolSummary":"File edit"}}]}
