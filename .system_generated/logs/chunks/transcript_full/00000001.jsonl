it page.goto(url, wait_until=\"load\", timeout=30000)\n        await page.wait_for_load_state(\"networkidle\", timeout=10000)\n        return await page.content()\n    except PlaywrightTimeoutError:\n        logger.warning(\"Timeout while loading %s\", url)\n        return \"\"\n    except Exception as exc:\n        logger.exception(\"Error fetching %s: %s\", url, exc)\n        return \"\"\n\nasync def discover_subpages(base_url: str) -> List[str]:\n    \"\"\"Return absolute URLs that respond successfully for the common paths.\n    Performs lightweight HEAD requests using Playwright's request API.\n    \"\"\"\n    discovered = []\n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True)\n        context = await browser.new_context()\n        request = context.request\n        for path in COMMON_PATHS:\n            candidate = urljoin(base_url, path)\n            try:\n                resp = await request.head(candidate)\n                if resp and resp.ok:\n                    discovered.append(candidate)\n            except Exception:\n                continue\n        await context.close()\n        await browser.close()\n    return discovered\n\nasync def process_domain(domain: str) -> str:\n    \"\"\"Crawl *domain* and return a single cleaned markdown string.\n    Aggregates homepage and any discovered sub‑pages.\n    \"\"\"\n    base_url = f\"https://{domain}\" if not domain.startswith(\"http\") else domain\n    async with async_playwright() as p:\n        browser = await p.chromium.launch(headless=True)\n        context = await browser.new_context()\n        page = await context.new_page()\n        # Homepage\n        homepage_html = await fetch_page(page, base_url)\n        contents = []\n        if homepage_html:\n            contents.append(clean_html(homepage_html))\n        # Sub‑pages\n        subpages = await discover_subpages(base_url)\n        for url in subpages:\n            html = await fetch_page(page, url)\n            if html:\n                contents.append(clean_html(html))\n        await context.close()\n        await browser.close()\n    return \"\\n\\n---\\n\\n\".join(filter(None, contents))\n","Description":"Create crawler module with increased timeouts","Overwrite":true,"TargetFile":"C:\\Users\\new\\.gemini\\antigravity\\brain\\4fdbd629-b1b9-4bee-a13c-8876484f2243\\lead_enrichment\\crawler.py","toolAction":"Create crawler with higher timeout","toolSummary":"File edit"}}]}
