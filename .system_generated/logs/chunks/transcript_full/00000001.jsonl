 install 0.28. Let's do: pip install openai==0.28. Then adjust code to use the old API but we already have old code commented out? Our llm uses new API; but older version also supports ChatCompletion.create. Actually older version's `openai.ChatCompletion.create` works. Our code currently uses new API which fails due to proxies. Might be easier to revert to old API using `openai.ChatCompletion.create`, which likely works under 0.28. So we need to downgrade openai and adjust code accordingly.\n\nWe will edit llm.py to use older API approach, and also create requirements pin.\n\nLet's edit llm.py to use previous implementation (the one before we edited). We'll replace entire file content with version that uses openai.ChatCompletion.create and avoid proxies.\n\nAlso update requirements to pin openai==0.28.\n\nLet's replace llm.py.\n\n","tool_calls":[{"name":"write_to_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Fix OpenAI client","UserFacing":false},"CodeContent":"# lead_enrichment/llm.py\n\"\"\"LLM abstraction layer.\nImplements a simple factory that returns a concrete client based on the\nenvironment variable ``LLM_PROVIDER``. The default implementation uses the\nlegacy OpenAI ChatCompletion API (v0.x) which works with the pinned\n``openai==0.28`` package.\n\"\"\"\n\nimport json\nimport logging\nfrom typing import Any, Dict\n\nfrom .models import CompanyInfo\nfrom .config import load_config\n\n_logger = logging.getLogger(__name__)\n\n# ---------------------------------------------------------------------------\n# Base class\n# ---------------------------------------------------------------------------\n\nclass BaseLLM:\n    \"\"\"Abstract LLM client.\n\n    Sub‑classes must implement ``extract_info`` which receives the domain and\n    the cleaned markdown content and returns a :class:`CompanyInfo` model.\n    \"\"\"\n\n    def __init__(self, config: Dict[str, Any]):\n        self.config = config\n\n    async def extract_info(self, domain: str, content: str) -> CompanyInfo:  # pragma: no cover\n        raise NotImplementedError\n\n# ---------------------------------------------------------------------------\n# OpenAI implementation (legacy v0.x API)\n# ---------------------------------------------------------------------------\n\nclass OpenAIClient(BaseLLM):\n    def __init__(self, config: Dict[str, Any]):\n        super().__init__(config)\n        try:\n            import openai\n        except ImportError as exc:\n            raise RuntimeError(\"openai package is required for OpenAIClient\") from exc\n        self.openai = openai\n        self.api_key = config.get(\"openai_api_key\")\n        if not self.api_key:\n            raise ValueError(\"OPENAI_API_KEY is not set in the environment\")\n        self.openai.api_key = self.api_key\n        # Model can be overridden via env var ``OPENAI_MODEL``\n        self.model = config.get(\"openai_model\", \"gpt-4o-mini\")\n\n    async def extract_info(self, domain: str, content: str) -> CompanyInfo:\n        system_prompt = (\n            \"You are a lead enrichment assistant. Extract the required fields from the given \"\n            \"website content and return a JSON object that conforms exactly to the following \"\n            \"Pydantic schema:\"\n        )\n        schema = CompanyInfo.schema_json(indent=2)\n        # Truncate to avoid token limits (approx 12k chars ~ 4k tokens)\n        truncated = content[:12000]\n        user_prompt = (\n            f\"Domain: {domain}\\n\\n\"\n            f\"Content:\\n{truncated}\\n\\n\"\n            \"Extract the information and output ONLY a JSON object matching the schema.\"\n            f\"\\nSchema:\\n{schema}\"\n        )\n        # The legacy OpenAI SDK is synchronous; run it in a thread.\n        response = await self._call_chat(system_prompt, user_prompt, domain)\n        try:\n            data = json.loads(response)\n            return CompanyInfo(**data)\n        except Exception as exc:\n            _logger.exception(\"Failed to parse LLM response for %s\", domain)\n            raise ValueError(\"Invalid LLM JSON response\") from exc\n\n    async def _call_chat(self, system: str, user: str, domain: str) -> str:\n        import asyncio\n\n        def _sync_call():\n            completion = self.openai.ChatCompletion.create(\n                model=self.model,\n                messages=[{\"role\": \"system\", \"content\": system}, {\"role\": \"user\", \"content\": user}],\n                temperature=0.0,\n            )\n            usage = getattr(completion, \"usage\", None)\n            if usage:\n                from .utils import log_token_usage\n                log_token_usage(domain=domain, provider=\"openai\", prompt_tokens=usage.get(\"prompt_tokens\", 0), completion_tokens=usage.get(\"completion_tokens\", 0))\n            return completion.choices[0].message.content.strip()\n\n        return await asyncio.to_thread(_sync_call)\n\n# ---------------------------------------------------------------------------\n# Factory\n# ---------------------------------------------------------------------------\n\ndef get_llm_client(config: Dict[str, Any]) -> BaseLLM:\n    provider = config.get(\"llm_provider\", \"openai\").lower()\n    if provider == \"openai\":\n        return OpenAIClient(config)\n    raise ValueError(f\"Unsupported LLM provider: {provider}\")\n","Description":"Replace LLM implementation with legacy OpenAI client compatible with pinned version","Overwrite":true,"TargetFile":"C:\\Users\\new\\.gemini\\antigravity\\brain\\4fdbd629-b1b9-4bee-a13c-8876484f2243\\lead_enrichment\\llm.py","toolAction":"Update OpenAI client to legacy version","toolSummary":"File edit"}}]}
